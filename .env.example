# ============================================================
# Brand Reputation Early-Warning System — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values before running.
# Every variable the system needs is listed here.

# ---------------------------
# SearXNG
# ---------------------------

# Base URL of the SearXNG instance (JSON API).
# If using the provided docker-compose.yml, this is http://localhost:8080
# Where to get it: starts automatically via `docker compose up`
SEARXNG_BASE_URL=http://localhost:8080

# Host port for SearXNG (optional, defaults to 8080 in docker-compose.yml)
# Only change this if port 8080 is already in use on your machine.
# SEARXNG_PORT=8080

# ---------------------------
# Phase 3: Extraction
# ---------------------------

MIN_TEXT_CHARS=100
MIN_TEXT_WORDS=20
HTTP_EXTRACTION_TIMEOUT=15
PLAYWRIGHT_EXTRACTION_TIMEOUT=15

# ---------------------------
# Phase 5: MongoDB Persistence
# ---------------------------

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=brand_reputation
MONGODB_COLLECTION=mentions

# ---------------------------
# Phase 6: Embeddings & Event Clustering
# ---------------------------

EVENT_SIMILARITY_THRESHOLD=0.82
MAX_EVENT_WINDOW_DAYS=30

# ---------------------------
# Phase 8: Risk Engine (Uncalibrated Engineering Parameters)
# ---------------------------

EVENT_ANOMALY_BOOST=15.0
RISK_THRESHOLD_MEDIUM=30.0
RISK_THRESHOLD_HIGH=55.0
RISK_THRESHOLD_CRITICAL=75.0
GLOBAL_BRAND_SCORE_CRITICAL=50.0
GLOBAL_BRAND_SCORE_HIGH=70.0
GLOBAL_BRAND_SCORE_ELEVATED=85.0

# ---------------------------
# Phase 9: FastAPI Server & CORS
# ---------------------------

# Comma-separated list of allowed origins for web frontends.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_PORT=8000
API_HOST=0.0.0.0
